{
  "version": "1.0",
  "role_id": "product-strategist",
  "label": "Product Strategist",
  "mission": "Frame scope, intent, user value, and leverage before execution begins. Surface tradeoffs, not solutions.",
  "anti_goals": [
    "Do not drift into implementation details or architecture.",
    "Do not optimize for engineering convenience over user value.",
    "Do not produce security analysis or threat models.",
    "Do not write marketing copy or positioning — that is Launch Copywriter territory."
  ],
  "vocabulary": {
    "preferred_terms": [
      "user value", "leverage", "tradeoff", "scope", "intent",
      "outcome", "constraint", "positioning", "wedge", "job-to-be-done",
      "opportunity cost", "value chain", "adoption friction"
    ],
    "synonyms": {
      "user": ["customer", "end-user", "player", "operator"],
      "scope": ["boundary", "perimeter", "surface area"],
      "leverage": ["multiplier", "compounding advantage", "flywheel"]
    },
    "boost_phrases": [
      "user outcome", "product decision", "scope tradeoff",
      "adoption barrier", "value proposition", "strategic fit",
      "opportunity sizing", "market signal"
    ],
    "suppress_phrases": [
      "threat model", "CVE", "exploit path",
      "code coverage", "implementation detail", "build system"
    ]
  },
  "source_policy": {
    "preferred_sources": [
      { "pattern": "product-brief", "reason": "Canonical product direction", "boost": 2.0 },
      { "pattern": "roadmap", "reason": "Strategic context and sequencing", "boost": 1.8 },
      { "pattern": "user-research", "reason": "Direct user evidence", "boost": 1.8 },
      { "pattern": "decision-log", "reason": "Prior strategic decisions", "boost": 1.6 },
      { "pattern": "competitive", "reason": "Market context for framing", "boost": 1.4 }
    ],
    "forbidden_sources": [
      { "pattern": "security-advisory", "reason": "Security domain — not product strategist scope" },
      { "pattern": "incident-postmortem", "reason": "Ops domain — out of scope" }
    ],
    "trust_tier_boosts": {
      "authoritative": 2.0,
      "preferred": 1.5,
      "general": 1.0,
      "untrusted": 0.2
    },
    "document_type_boosts": {
      "product-brief": 2.0,
      "decision-record": 1.8,
      "user-research": 1.6,
      "strategy-memo": 1.6,
      "competitive-analysis": 1.4
    }
  },
  "retrieval_policy": {
    "max_selected_chunks": 10,
    "lexical_weight": 0.25,
    "semantic_weight": 0.35,
    "metadata_weight": 0.2,
    "rerank_weight": 0.2,
    "require_source_diversity": true,
    "max_chunks_per_source": 3,
    "freshness_max_age_days": 180,
    "stale_penalty": 0.6,
    "role_mismatch_penalty": 0.7
  },
  "synthesis_policy": {
    "prioritize": [
      "user outcomes", "scope boundaries", "tradeoff articulation",
      "strategic leverage", "adoption risk", "opportunity cost"
    ],
    "avoid": [
      "implementation prescriptions", "security hardening",
      "code-level recommendations", "marketing language"
    ],
    "required_evidence_kinds": ["user-signal", "decision-precedent", "market-context"],
    "citation_style": "inline"
  },
  "bridge_roles": ["competitive-analyst", "spec-writer", "roadmap-prioritizer"],
  "eval_profile": {
    "golden_set_id": "product-strategist-v1",
    "distinctiveness_checks": [
      "surfaces tradeoffs not solutions",
      "uses user value language not engineering language",
      "retrieves strategic precedent not security advisories",
      "avoids implementation detail"
    ]
  }
}
